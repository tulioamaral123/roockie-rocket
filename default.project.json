{
  "name": "nasa-space-adventure",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "MissionSystem": {
        "$className": "Folder",
        "$attributes": {
          "RojoManaged": true
        },
        "Remotes": {
          "$className": "Folder",
          "StartMission": {
            "$className": "RemoteEvent"
          },
          "MissionUpdate": {
            "$className": "RemoteEvent"
          },
          "MissionAction": {
            "$className": "RemoteEvent"
          },
          "SubmitCode": {
            "$className": "RemoteEvent"
          },
          "SubmitChoice": {
            "$className": "RemoteEvent"
          }
        },
        "Config": {
          "$className": "Folder",
          "Friendship7Config": {
            "$path": "build/mission/Friendship7Config.luau"
          }
        }
      },
      "MuseumSystem": {
        "$className": "Folder",
        "$attributes": {
          "RojoManaged": true
        },
        "Shared": {
          "$path": "build/museum/shared"
        }
      }
    },
    "ServerScriptService": {
      "IntegracaoLinux": {
        "$path": "build/tests/IntegracaoLinux.server.luau"
      },
      "MissionSystem": {
        "$className": "Folder",
        "Friendship7MissionService": {
          "$path": "build/mission/Friendship7MissionService.server.luau",
          "Task1ControlService": {
            "$path": "build/mission/Task1ControlService.luau"
          },
          "Task2CommunicationService": {
            "$path": "build/mission/Task2CommunicationService.luau"
          },
          "Task3ReentryService": {
            "$path": "build/mission/Task3ReentryService.luau"
          }
        }
      },
      "MuseumSystem": {
        "$path": "build/museum/server"
      },
      "Map_Systems": {
        "$path": "build/systems/server",
        "$attributes": {
          "RojoManaged": true
        }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "MissionClient": {
          "$className": "Folder",
          "MissionController": {
            "$path": "build/mission/MissionController.client.luau",
            "FirstPersonController": {
              "$path": "build/mission/FirstPersonController.luau"
            },
            "CameraShakeController": {
              "$path": "build/mission/CameraShakeController.luau"
            },
            "GazeInteractionController": {
              "$path": "build/mission/GazeInteractionController.luau"
            },
            "PanelInteractionController": {
              "$path": "build/mission/PanelInteractionController.luau"
            },
            "AudioController": {
              "$path": "build/mission/AudioController.luau"
            },
            "PanelDisplays": {
              "$path": "build/mission/PanelDisplays.luau"
            }
          }
        },
        "MuseumClient": {
          "$path": "build/museum/client"
        },
        "MapClient": {
          "$path": "build/systems/client"
        }
      }
    }
  }
}

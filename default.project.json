{
  "name": "nasa-space-adventure",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "MuseumSystem": {
        "$className": "Folder",
        "$attributes": {
          "RojoManaged": true
        },
        "Shared": {
          "$path": "build/museum/shared"
        }
      },
      "RookieRocket": {
        "$className": "Folder",
        "$attributes": {
          "RojoManaged": true
        },
        "Config": {
          "$path": "build/rookie/shared"
        },
        "Remotes": {
          "$className": "Folder",
          "SelecionarEquipamento": {
            "$className": "RemoteEvent"
          },
          "IniciarLancamento": {
            "$className": "RemoteEvent"
          },
          "AcaoTask": {
            "$className": "RemoteEvent"
          },
          "ReiniciarTaskOuMissao": {
            "$className": "RemoteEvent"
          },
          "SincronizarEstado": {
            "$className": "RemoteEvent"
          }
        }
      }
    },
    "ServerScriptService": {
      "IntegracaoLinux": {
        "$path": "build/tests/IntegracaoLinux.server.luau"
      },
      "MuseumSystem": {
        "$path": "build/museum/server"
      },
      "Map_Systems": {
        "$path": "build/systems/server",
        "$attributes": {
          "RojoManaged": true
        }
      },
      "RookieRocket": {
        "$path": "build/rookie/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "MuseumClient": {
          "$path": "build/museum/client"
        },
        "MapClient": {
          "$path": "build/systems/client"
        },
        "RookieClient": {
          "$path": "build/rookie/client"
        }
      }
    }
  }
}
